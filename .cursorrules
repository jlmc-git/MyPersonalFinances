## CQRS with MediatR (STRICT)

Controllers dispatch MediatR requests and return HTTP responses. That is all they do.

### Controller pattern

```csharp
[ApiController]
[Route("api/v1/[controller]")]
public sealed class TransactionsController : ApiControllerBase
{
    private readonly IMediator _mediator;
    public TransactionsController(IMediator mediator) => _mediator = mediator;

    [HttpGet("{id}")]
    public async Task<ActionResult<TransactionDto>> GetById(
        Guid id,
        CancellationToken cancellationToken)
    {
        Guid callerId = GetCurrentUserId();
        Result<TransactionDto> result =
            await _mediator.Send(new GetTransactionByIdQuery(id, callerId), cancellationToken);
        return result.IsSuccess ? Ok(result.Value) : result.ToProblemResult();
    }

    [HttpPost]
    public async Task<ActionResult<TransactionDto>> Create(
        CreateTransactionCommand command,
        CancellationToken cancellationToken)
    {
        Guid callerId = GetCurrentUserId();
        Result<TransactionDto> result =
            await _mediator.Send(command with { UserId = callerId }, cancellationToken);
        return result.IsSuccess
            ? CreatedAtAction(nameof(GetById), new { id = result.Value!.Id }, result.Value)
            : result.ToProblemResult();
    }
}
```

### Handler pattern

```csharp
public sealed class GetTransactionByIdQueryHandler
    : IRequestHandler<GetTransactionByIdQuery, Result<TransactionDto>>
{
    private readonly ITransactionRepository _transactionRepository;

    public GetTransactionByIdQueryHandler(ITransactionRepository transactionRepository)
        => _transactionRepository = transactionRepository;

    public async Task<Result<TransactionDto>> Handle(
        GetTransactionByIdQuery query,
        CancellationToken cancellationToken)
    {
        Transaction? transaction =
            await _transactionRepository.GetByIdAsync(query.Id, cancellationToken);

        if (transaction is null)
            return Result.Failure<TransactionDto>(Error.NotFound(query.Id));

        if (transaction.UserId != query.CallerId)
            return Result.Failure<TransactionDto>(Error.Forbidden(query.Id));

        return Result.Success(TransactionMapper.ToDto(transaction));
    }
}
```

### MediatR registration

```csharp
builder.Services.AddMediatR(cfg =>
    cfg.RegisterServicesFromAssembly(typeof(CreateTransactionCommand).Assembly));
```

Anti-patterns (STRICTLY FORBIDDEN):
- Business logic in Controllers
- Injecting repositories directly into Controllers
- Handlers calling other handlers
- ServiceLocator or static access to IMediator
- Static classes anywhere

---

## Result<T> Pattern (STRICT)

Business errors use `Result<T>`. Exceptions are reserved for infrastructure failures
and domain invariant violations.

```csharp
// Application/Shared/Results/Result.cs
public sealed class Result<T>
{
    public bool IsSuccess { get; }
    public T? Value { get; }
    public Error? Error { get; }

    private Result(bool isSuccess, T? value, Error? error)
    {
        IsSuccess = isSuccess;
        Value = value;
        Error = error;
    }

    public static Result<T> Success(T value) => new(true, value, null);
    public static Result<T> Failure(Error error) => new(false, default, error);
}

public static class Result
{
    public static Result<T> Success<T>(T value) => Result<T>.Success(value);
    public static Result<T> Failure<T>(Error error) => Result<T>.Failure(error);
}
```

```csharp
// Application/Shared/Results/Error.cs
public sealed record Error(string Code, string Message)
{
    public static Error NotFound(Guid id) =>
        new("not_found", $"Resource '{id}' was not found.");

    public static Error Forbidden(Guid id) =>
        new("forbidden", $"Access to resource '{id}' is forbidden.");

    public static Error Validation(string message) =>
        new("validation", message);
}
```

```csharp
// Api/Shared/Extensions/ResultExtensions.cs
public static class ResultExtensions
{
    public static ActionResult ToProblemResult<T>(this Result<T> result) =>
        result.Error!.Code switch
        {
            "not_found"  => new NotFoundObjectResult(ToProblem(result.Error, 404)),
            "forbidden"  => new ObjectResult(ToProblem(result.Error, 403)) { StatusCode = 403 },
            "validation" => new UnprocessableEntityObjectResult(ToProblem(result.Error, 422)),
            _            => new ObjectResult(ToProblem(result.Error, 500)) { StatusCode = 500 },
        };

    private static ProblemDetails ToProblem(Error error, int status) => new()
    {
        Status = status,
        Title  = error.Code,
        Detail = error.Message,
    };
}
```

Rules:
- Handlers NEVER throw exceptions for business errors — return `Result.Failure(Error.X(...))`
- `DomainException` is still thrown in domain factory methods for invariant violations -> middleware catches -> 400
- NEVER throw `ApplicationException` or `InvalidOperationException` for business flows

